{
  "scenarios": [
    {
      "label": "documented complete message",
      "steps": [
        { "kind": "event", "event": { "type": "message_start", "message": { "content": [] } } },
        { "kind": "event", "event": { "type": "ping" } },
        { "kind": "event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } } },
        { "kind": "event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "hello" } } },
        { "kind": "event", "event": { "type": "content_block_stop", "index": 0 } },
        { "kind": "event", "event": { "type": "message_delta", "delta": { "stop_reason": "end_turn" }, "usage": { "output_tokens": 1 } } },
        { "kind": "event", "event": { "type": "message_stop" } }
      ]
    },
    {
      "label": "stream error",
      "steps": [
        { "kind": "event", "event": { "type": "error", "error": { "type": "api_error", "message": "fixture" } } }
      ]
    },
    {
      "label": "transport disconnect",
      "steps": [
        { "kind": "disconnect", "reason": "fixture" }
      ]
    }
  ]
}
