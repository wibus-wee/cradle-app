{
  "name": "@cradle/cli",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "cradle": "./dist/index.cjs"
  },
  "scripts": {
    "build": "tsdown && chmod +x dist/index.cjs",
    "gen:cli": "tsx scripts/generate-cli.ts",
    "typecheck": "tsc --noEmit",
    "cradle": "tsx src/index.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@cradle/plugin-sdk": "workspace:*",
    "commander": "^14.0.3",
    "marked": "^15.0.0",
    "picocolors": "^1.1.1",
    "string-width": "^8.2.1",
    "table": "^6.9.0",
    "vite": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
