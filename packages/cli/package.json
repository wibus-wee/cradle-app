{
  "name": "@cradle/cli",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "cradle": "./dist/index.cjs"
  },
  "scripts": {
    "build": "tsdown && chmod +x dist/index.cjs",
    "gen:cli": "tsx scripts/generate-cli.ts",
    "typecheck": "tsc --noEmit",
    "cradle": "tsx src/index.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@cradle/plugin-sdk": "workspace:*",
    "commander": "^15.0.0",
    "marked": "^18.0.11",
    "picocolors": "^1.1.1",
    "string-width": "^8.2.2",
    "table": "^6.9.0",
    "vite": "^8.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
