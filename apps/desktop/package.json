{
  "name": "@cradle/desktop",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Cradle desktop app",
  "desktopName": "Cradle.desktop",
  "author": {
    "email": "wibus_wee@outlook.com",
    "name": "wibus-wee",
    "url": "https://wibus.ren"
  },
  "homepage": "https://github.com/wibus-wee/cradle-app",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && node scripts/rebuild-sparkle.mjs",
    "dev": "pnpm build:mac-bridge && electron-vite dev",
    "sync:codex-runtime": "node scripts/sync-codex-runtime.mjs --current",
    "sync:codex-runtime:all": "node scripts/sync-codex-runtime.mjs --all",
    "build": "pnpm --filter @cradle/server build:desktop-runtime && pnpm --filter @cradle/server build:desktop-plugins && pnpm --filter @cradle/cli build && pnpm build:mac-bridge && pnpm rebuild:sparkle && electron-vite build",
    "build:relayd-resource": "pnpm --filter @cradle/relayd build:desktop-resource",
    "build:mac-bridge": "node scripts/build-mac-bridge.mjs",
    "generate:tray-icon": "node scripts/generate-tray-icon.mjs",
    "rebuild:sparkle": "node scripts/rebuild-sparkle.mjs",
    "record:appshot-parity": "node scripts/record-appshot-parity.mjs",
    "set-version": "node scripts/set-version.mjs",
    "pack": "pnpm build && electron-builder --config electron-builder.mjs --dir && pnpm m0:custom-scheme:packaged",
    "verify:macos-distribution-credentials": "node scripts/verify-macos-distribution-credentials.mjs",
    "dist": "pnpm build && electron-builder --config electron-builder.mjs",
    "dist:publish": "pnpm build && electron-builder --config electron-builder.mjs --publish always",
    "dist:mac": "pnpm build && electron-builder --config electron-builder.mjs --mac",
    "generate-appcast": "electron-sparkle-updater generate-appcast",
    "smoke:update": "node scripts/run-update-smoke.mjs",
    "dist:win": "pnpm build && electron-builder --config electron-builder.mjs --win",
    "dist:linux": "pnpm build && electron-builder --config electron-builder.mjs --linux",
    "generate:linux-update-manifest": "node scripts/generate-linux-update-manifest.mjs",
    "verify:linux-release": "node scripts/verify-linux-release.mjs",
    "typecheck": "pnpm --filter @cradle/plugin-sdk build && tsc --noEmit -p tsconfig.node.json",
    "m0:custom-scheme:prepare": "pnpm --filter @cradle/system-info build && node src/main/desktop-server-transport/fixtures/m0/prepare-real-plugin.mjs",
    "m0:custom-scheme:build": "pnpm m0:custom-scheme:prepare && electron-vite build --config src/main/desktop-server-transport/fixtures/m0/electron.vite.config.ts",
    "m0:custom-scheme:dev": "node src/main/desktop-server-transport/fixtures/m0/run-m0.mjs --mode development",
    "m0:custom-scheme:pack": "pnpm m0:custom-scheme:build && electron-builder --config src/main/desktop-server-transport/fixtures/m0/electron-builder.mjs --dir --publish never",
    "m0:custom-scheme:packaged": "pnpm m0:custom-scheme:pack && node src/main/desktop-server-transport/fixtures/m0/run-m0.mjs --mode packaged",
    "m0:custom-scheme:gate": "pnpm m0:custom-scheme:dev && pnpm m0:custom-scheme:packaged"
  },
  "dependencies": {
    "@cradle/browser-use": "workspace:*",
    "@cradle/download-center": "workspace:*",
    "@cradle/ipc": "workspace:*",
    "@cradle/plugin-sdk": "workspace:*",
    "@cradleapp/ai-sdk": "workspace:*",
    "electron-sparkle-updater": "0.1.0",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "get-port": "^7.1.0",
    "tar": "^7.5.13",
    "undici": "7.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "es-module-lexer": "2.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
