{
  "name": "@cradle/server",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "main": "src/index.ts",
  "files": [
    "!dist/desktop-plugins/**",
    "!dist/desktop-runtime/**",
    "!dist/node_modules/**",
    "!dist/package.json",
    "dist/**"
  ],
  "scripts": {
    "dev": "nodemon",
    "build": "pnpm --filter @cradle/plugin-sdk build && vite build",
    "build:desktop-plugins": "pnpm --filter \"../../plugins/*\" build && node scripts/prepare-desktop-plugins.mjs",
    "build:desktop-runtime": "pnpm run build && node scripts/prepare-desktop-runtime.mjs && node scripts/rebuild-electron-runtime.mjs",
    "start": "node dist/main.js",
    "generate:codex-app-server-protocol": "node scripts/generate-codex-app-server-protocol.mjs && node scripts/generate-codex-app-server-capabilities.mjs",
    "generate:codex-app-server-capabilities": "node scripts/generate-codex-app-server-capabilities.mjs",
    "generate:kimi-web-protocol": "tsx scripts/generate-kimi-web-protocol.ts",
    "generate:kimi-web-protocol-bindings": "tsx scripts/generate-kimi-web-protocol-bindings.ts",
    "sync:opencode-runtime-manifest": "node scripts/sync-opencode-runtime-manifest.mjs",
    "tab-working-set:collect": "python3 scripts/tab_working_set_collector.py",
    "leak:harness": "tsx scripts/leak-harness.ts",
    "typecheck": "pnpm --filter @cradle/plugin-sdk build && tsc --noEmit && pnpm check:boundaries && pnpm check:stream-boundaries",
    "check:boundaries": "tsx scripts/check-module-boundaries.ts",
    "check:stream-boundaries": "tsx scripts/check-stream-enqueue-boundary.ts",
    "test": "pnpm --filter @cradle/plugin-sdk build && pnpm --filter \"../../plugins/*\" build && vitest run",
    "test:watch": "vitest",
    "benchmark:session-startup": "vite build --config vite.benchmark.config.ts && node --import tsx scripts/session-startup-benchmark.ts",
    "benchmark:relay": "vitest run tests/relay-transport/performance-compare.test.ts --reporter=verbose",
    "benchmark:relay:codec": "CRADLE_RELAY_BENCHMARK=1 vitest run tests/relay-transport/codec-throughput-benchmark.test.ts --reporter=verbose --maxWorkers=1 --no-file-parallelism",
    "benchmark:relay:full": "pnpm run benchmark:relay && pnpm run benchmark:relay:runtime",
    "benchmark:relay:runtime": "CRADLE_RELAY_BENCHMARK=1 vitest run tests/relay-transport/codec-throughput-benchmark.test.ts tests/relay-transport/adverse-network-benchmark.test.ts tests/relay-transport/latency-window-benchmark.test.ts --reporter=verbose --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@ai-sdk/google": "^3.0.72",
    "@ai-sdk/openai": "^3.0.53",
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@anthropic-ai/sdk": "0.115.0",
    "@arcships/light-ocr": "0.5.7",
    "@babel/parser": "^8.0.4",
    "@cradle/chat-runtime-contracts": "workspace:*",
    "@cradle/db": "workspace:*",
    "@cradle/download-center": "workspace:*",
    "@cradle/plugin-sdk": "workspace:*",
    "@cradleapp/ai-sdk": "workspace:*",
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@ff-labs/fff-node": "^0.10.5",
    "@hijarvis/core": "^0.1.0",
    "@hono/node-server": "^2.1.1",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@node-rs/jieba": "^2.0.2",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@opencode-ai/sdk": "^1.18.25",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/host-metrics": "^0.39.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.34.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@scalar/hono-api-reference": "^0.12.0",
    "@tsuki-hono/common": "0.0.5",
    "@tsuki-hono/core": "0.0.5",
    "ai": "^6.0.168",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "es-module-lexer": "^2.3.2",
    "fast-glob": "^3.3.3",
    "format-duration": "^4.0.0",
    "hono": "4.13.5",
    "ignore": "^7.0.6",
    "js-yaml": "^5.4.1",
    "jsonrepair": "^3.15.0",
    "node-pty": "1.2.0-beta.13",
    "octokit": "^5.0.5",
    "ofetch": "1.5.1",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "safe-stable-stringify": "2.5.0",
    "sharp": "0.35.4",
    "simple-git": "^3.36.0",
    "smol-toml": "^1.8.0",
    "tar": "^7.5.22",
    "tsyringe": "^4.10.0",
    "undici": "^8.10.0",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@alint-js/cli": "^0.7.1",
    "@cradle/model-api-simulator": "workspace:*",
    "@electron/rebuild": "4.2.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@octokit/types": "^18.0.0",
    "@sinclair/typebox": "0.34.52",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "@types/yauzl": "^3.4.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.11",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
