{
  "name": "@cradle/e2e-personal-panel",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "cradle": {
    "apiVersion": "1",
    "displayName": "E2E Personal Panel",
    "description": "Real personal Plugin installation fixture",
    "web": "dist/web.mjs",
    "contributes": {
      "capabilities": [
        {
          "id": "panel.personal-lifecycle",
          "type": "web-panel",
          "layer": "web",
          "label": "Personal lifecycle panel",
          "permissions": ["workspace.metadata.read"]
        }
      ],
      "permissions": [
        {
          "id": "workspace.metadata.read",
          "label": "Read workspace metadata",
          "description": "Read workspace names without accessing file contents.",
          "required": true
        }
      ]
    }
  }
}
